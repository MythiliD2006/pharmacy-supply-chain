# ---------- server ----------
PORT=5000
NODE_ENV=development
# where the Next.js app runs (CORS + the link inside QR codes)
FRONTEND_URL=http://localhost:3000

# ---------- database ----------
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pharma-supply-chain?retryWrites=true&w=majority

# ---------- auth ----------
# any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# first admin login, created by: npm run seed:admin
ADMIN_EMAIL=admin@pharmachain.com
ADMIN_PASSWORD=Admin@1234
# password for the demo participant logins created by: npm run seed:demo
DEMO_PASSWORD=Demo@1234

# ---------- blockchain ----------
# local:   http://127.0.0.1:8545   chain id 31337
# sepolia: your Alchemy/Infura URL chain id 11155111
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# from contracts/deployments/<network>.json
ACCESS_CONTROL_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BATCH_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
SUPPLY_CHAIN_TRANSFER_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# wallet that deployed the contracts (it is the on-chain admin)
# local: Hardhat account #0. On Sepolia use your deployer key and never commit it.
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---------- event sync ----------
# Sepolia: set START_BLOCK to startBlock from contracts/deployments/sepolia.json
START_BLOCK=0
EVENT_POLL_MS=4000
LOG_CHUNK_SIZE=500
EVENT_CONFIRMATIONS=0